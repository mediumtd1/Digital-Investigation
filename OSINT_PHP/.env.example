# ─────────────────────────────────────────────
# OSINT PHP — .env configuration
# Copy this to .env and fill in your API keys
# ─────────────────────────────────────────────

# All keys are optional — app uses demo/mock data if not set

VIRUSTOTAL_API_KEY=your_virustotal_api_key
ABUSEIPDB_API_KEY=your_abuseipdb_api_key
IPINFO_TOKEN=your_ipinfo_token
PHISHTANK_APP_KEY=your_phishtank_app_key
HIBP_API_KEY=your_haveibeenpwned_api_key

# Groq AI — get free key at console.groq.com
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant
